{
  "name": "shapy-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the shapy generative background Web Component.",
  "author": {
    "name": "Hemant Rao",
    "url": "https://github.com/hemant-rao"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hemant-rao"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @shapy/demo run dev",
    "dev:example": "vite . --open /examples/minimal.html",
    "build": "npm --workspace @shapy/demo run build",
    "build:template": "npm --workspace shapy run build:template && node scripts/sync-standalone.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "test": "node --test tests/package.test.mjs tests/render.test.mjs",
    "test:e2e": "node --test tests/render.e2e.test.mjs",
    "verify": "npm run build:template && npm run check:repo && npm test && npm run build && npm run pack:check",
    "pack:shapy": "npm pack --workspace shapy",
    "pack:render": "npm pack --workspace shapy-render",
    "pack:check": "npm run pack:shapy -- --dry-run && npm run pack:render -- --dry-run",
    "publish:shapy": "npm publish --workspace shapy",
    "publish:render": "npm publish --workspace shapy-render"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemant-rao/Shapy.git"
  },
  "homepage": "https://github.com/hemant-rao/Shapy#readme",
  "bugs": {
    "url": "https://github.com/hemant-rao/Shapy/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT"
}
