{
  "name": "shapy-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the shapy generative background Web Component.",
  "workspaces": [
    "shapy",
    "vue-demo"
  ],
  "scripts": {
    "dev": "npm --workspace vue-demo run dev",
    "build": "npm --workspace vue-demo run build",
    "build:template": "npm --workspace shapy run build:template",
    "verify": "npm run build:template && npm run build && npm run pack:check",
    "pack:shapy": "npm pack --workspace shapy",
    "pack:check": "npm run pack:shapy -- --dry-run",
    "publish:shapy": "npm publish --workspace shapy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemant-rao/Shapy.git"
  },
  "license": "MIT"
}
